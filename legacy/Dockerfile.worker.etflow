# Isolated upstream-compatible ET-Flow environment; requires an immutable source commit.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04
ARG ETFLOW_GIT_COMMIT
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    SATORI_DATA_DIR=/opt/satori/data SATORI_ARTIFACT_DIR=/opt/satori/artifacts \
    SATORI_STATE_DB=/opt/satori/artifacts/state/jobs.sqlite3 \
    SATORI_STORAGE_URI=/opt/satori/artifacts SATORI_MODEL_REGISTRY=/opt/satori/model_registry.json \
    SATORI_MODEL_CACHE_DIR=/opt/satori/model-cache SATORI_WORKER_QUEUE=etflow \
    SATORI_DEVICE=cuda HF_HOME=/opt/satori/model-cache/huggingface
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3-pip git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/local/bin/python
WORKDIR /opt/satori
COPY requirements/etflow.lock requirements/etflow.lock
RUN python -m pip install --no-cache-dir --upgrade pip==25.0.1 \
    && python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu121 \
      torch==2.5.1+cu121 \
    && python -m pip install --no-cache-dir -r requirements/etflow.lock \
    && python -m pip install --no-cache-dir --no-build-isolation \
      pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv \
      -f https://data.pyg.org/whl/torch-2.5.1+cu121.html \
    && python -m pip install --no-cache-dir torch-geometric==2.6.1
RUN test -n "$ETFLOW_GIT_COMMIT" \
    && echo "$ETFLOW_GIT_COMMIT" | grep -Eq '^[0-9a-fA-F]{40}$' \
    && python -m pip install --no-cache-dir \
      "git+https://github.com/shenoynikhil/ETFlow.git@$ETFLOW_GIT_COMMIT"
COPY pyproject.toml README.md ./
COPY src ./src
ENV PYTHONPATH=/opt/satori/src
RUN useradd --create-home --uid 10001 satori \
    && mkdir -p /opt/satori/data /opt/satori/artifacts/state /opt/satori/model-cache \
    && chown -R satori:satori /opt/satori
COPY model_registry.example.json /opt/satori/model_registry.json
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD ["python", "-m", "satori.worker", "--healthcheck"]
CMD ["python", "-m", "satori.worker"]
