# Copy to .env for a single-host cloud deployment. Inject credentials via the
# provider secret manager; do not commit non-empty secret values here.
SATORI_DATA_DIR=/opt/satori/data
SATORI_ARTIFACT_DIR=/opt/satori/artifacts
SATORI_STATE_DB=/opt/satori/artifacts/state/jobs.sqlite3
SATORI_STORAGE_URI=/opt/satori/artifacts
SATORI_MODEL_REGISTRY=/opt/satori/model_registry.json
SATORI_MODEL_CACHE_DIR=/opt/satori/model-cache
SATORI_API_HOST=0.0.0.0
SATORI_API_PORT=8000
SATORI_API_TOKEN=
SATORI_WORKER_POLL_SECONDS=2
SATORI_WORKER_QUEUE=cpu
SATORI_DEVICE=auto
SATORI_LOG_LEVEL=INFO
SATORI_IMAGE_DIGEST=unknown
HF_HOME=/opt/satori/model-cache/huggingface
ETFLOW_GIT_COMMIT=
