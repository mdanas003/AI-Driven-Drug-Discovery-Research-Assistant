FROM python:3.11.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SATORI_DATA_DIR=/opt/satori/data SATORI_ARTIFACT_DIR=/opt/satori/artifacts \
    SATORI_STATE_DB=/opt/satori/artifacts/state/jobs.sqlite3 \
    SATORI_STORAGE_URI=/opt/satori/artifacts SATORI_MODEL_REGISTRY=/opt/satori/model_registry.json \
    SATORI_MODEL_CACHE_DIR=/opt/satori/model-cache SATORI_WORKER_QUEUE=docking
WORKDIR /opt/satori
COPY requirements/cpu.lock requirements/cpu.lock
RUN python -m pip install --no-cache-dir -r requirements/cpu.lock \
    && apt-get update && apt-get install -y --no-install-recommends curl \
    && curl -fL --retry 3 \
      https://github.com/ccsb-scripps/AutoDock-Vina/releases/download/v1.2.7/vina_1.2.7_linux_x86_64 \
      -o /usr/local/bin/vina \
    && chmod 0755 /usr/local/bin/vina \
    && vina --version | grep -F '1.2.7' \
    && mkdir -p /usr/local/share/satori \
    && sha256sum /usr/local/bin/vina > /usr/local/share/satori/vina.sha256 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir --no-deps . \
    && useradd --create-home --uid 10001 satori \
    && mkdir -p /opt/satori/data /opt/satori/artifacts/state /opt/satori/model-cache \
    && chown -R satori:satori /opt/satori
COPY model_registry.example.json /opt/satori/model_registry.json
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python", "-m", "satori.worker", "--healthcheck"]
CMD ["python", "-m", "satori.worker"]
